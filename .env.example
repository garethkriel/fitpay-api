# Copy this file to .env and fill it in. Never commit .env: it holds secrets.

# SQLite file by default. For Postgres: postgresql+psycopg://user:password@host:5432/fitpay
FITPAY_DATABASE_URL=sqlite:///./fitpay.db

# Admin endpoints (clients, payments, reports) need this in the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FITPAY_ADMIN_API_KEY=

# The public address of the API. PayFast sends payment notifications to PUBLIC_URL/payfast/notify.
FITPAY_PUBLIC_URL=http://localhost:8000

# Clients are "due soon" when their paid-up date is this many days away or less.
FITPAY_DUE_SOON_DAYS=7

# PayFast. These defaults are PayFast's public sandbox merchant (test payments only).
FITPAY_PAYFAST_MERCHANT_ID=10000100
FITPAY_PAYFAST_MERCHANT_KEY=46f0cd694581a
FITPAY_PAYFAST_PASSPHRASE=
FITPAY_PAYFAST_SANDBOX=true
